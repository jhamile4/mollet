# Variables que necesita el perfil "prod". Copia este archivo como .env (ignorado por git)
# o configúralas en el panel de tu proveedor (Render). NUNCA subas los valores reales.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://<host>/<base>?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
